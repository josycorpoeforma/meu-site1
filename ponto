<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Corpoeforma — Estúdio de Massoterapia & Depilação | Ilhéus, BA</title>
<meta name="description" content="Estúdio Corpoeforma — massoterapia, drenagem linfática e depilação em Ilhéus, Bahia. Agende seu horário pelo WhatsApp.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400;1,9..144,500&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
  :root{
    --cream:#FBEDE6;
    --cream-2:#F4D9CD;
    --cacau:#2E1B12;
    --cacau-soft:#7A5240;
    --ocean:#A8465C;
    --ocean-dark:#6E2438;
    --ocean-light:#E48DA0;
    --rose:#8B5A3C;
    --rose-soft:#D9B79C;
    --gold:#C9A467;
    --white:#FFFBF8;
    --radius:22px;
    --maxw:1180px;
  }

  *{margin:0;padding:0;box-sizing:border-box;}

  html{scroll-behavior:smooth;}

  body{
    background:var(--cream);
    color:var(--cacau);
    font-family:'Manrope',sans-serif;
    font-weight:400;
    line-height:1.6;
    -webkit-font-smoothing:antialiased;
    overflow-x:hidden;
  }

  h1,h2,h3,.display{
    font-family:'Fraunces',serif;
    font-weight:500;
    line-height:1.08;
    letter-spacing:-0.01em;
    color:var(--cacau);
  }

  a{color:inherit;text-decoration:none;}
  img{max-width:100%;display:block;}
  ul{list-style:none;}
  button{font-family:inherit;cursor:pointer;border:none;background:none;}

  .wrap{max-width:var(--maxw);margin:0 auto;padding:0 32px;}

  .eyebrow{
    font-family:'Manrope',sans-serif;
    font-size:12.5px;
    font-weight:700;
    letter-spacing:0.16em;
    text-transform:uppercase;
    color:var(--ocean);
  }

  /* ===== Focus visibility ===== */
  a:focus-visible, button:focus-visible, input:focus-visible, textarea:focus-visible, select:focus-visible{
    outline:2.5px solid var(--ocean);
    outline-offset:3px;
    border-radius:6px;
  }

  /* ===== NAV ===== */
  header{
    position:fixed;
    top:0;left:0;right:0;
    z-index:100;
    padding:20px 0;
    transition:background .4s ease, padding .4s ease, box-shadow .4s ease;
  }
  header.scrolled{
    background:rgba(247,239,229,0.92);
    backdrop-filter:blur(10px);
    padding:14px 0;
    box-shadow:0 2px 24px rgba(58,36,24,0.06);
  }
  nav{
    display:flex;
    align-items:center;
    justify-content:space-between;
  }
  .logo{
    font-family:'Fraunces',serif;
    font-size:23px;
    font-weight:500;
    letter-spacing:-0.01em;
    display:flex;
    align-items:baseline;
    gap:6px;
  }
  .logo em{
    font-style:italic;
    color:var(--ocean);
  }
  .nav-links{
    display:flex;
    gap:38px;
    font-size:14.5px;
    font-weight:600;
  }
  .nav-links a{
    position:relative;
    padding:4px 0;
  }
  .nav-links a::after{
    content:'';
    position:absolute;
    left:0;bottom:0;
    width:0%;height:1.5px;
    background:var(--ocean);
    transition:width .3s ease;
  }
  .nav-links a:hover::after{width:100%;}
  .nav-cta{
    display:flex;align-items:center;gap:22px;
  }
  .btn{
    display:inline-flex;
    align-items:center;
    gap:9px;
    padding:13px 26px;
    border-radius:100px;
    font-size:14px;
    font-weight:700;
    letter-spacing:0.01em;
    transition:transform .25s ease, box-shadow .25s ease, background .25s ease;
    white-space:nowrap;
  }
  .btn-primary{
    background:linear-gradient(135deg, var(--ocean-light) 0%, var(--ocean) 55%, var(--ocean-dark) 100%);
    color:var(--white);
    box-shadow:0 10px 26px rgba(168,70,92,0.4);
  }
  .btn-primary:hover{
    transform:translateY(-2px) scale(1.02);
    box-shadow:0 16px 34px rgba(168,70,92,0.5);
  }
  .btn-ghost{
    border:1.5px solid var(--cacau);
    color:var(--cacau);
  }
  .btn-ghost:hover{background:var(--cacau);color:var(--white);}
  .btn-light{
    background:var(--white);
    color:var(--ocean-dark);
  }
  .btn-light:hover{transform:translateY(-2px);box-shadow:0 10px 24px rgba(0,0,0,0.15);}

  .menu-toggle{display:none;}

  /* ===== HERO ===== */
  .hero{
    position:relative;
    min-height:100vh;
    display:flex;
    align-items:center;
    padding:140px 0 120px;
    overflow:hidden;
  }
  .hero-grid{
    display:grid;
    grid-template-columns:1.05fr 0.95fr;
    gap:60px;
    align-items:center;
  }
  .hero-eyebrow{
    display:flex;align-items:center;gap:10px;
    margin-bottom:22px;
  }
  .hero-eyebrow .line{width:34px;height:1.5px;background:var(--gold);}
  .hero h1{
    font-size:clamp(40px, 5.4vw, 68px);
    margin-bottom:24px;
  }
  .hero h1 em{
    font-style:italic;
    color:var(--ocean);
  }
  .hero p.lede{
    font-size:18px;
    color:var(--cacau-soft);
    max-width:480px;
    margin-bottom:36px;
  }
  .hero-actions{display:flex;gap:16px;flex-wrap:wrap;margin-bottom:44px;}
  .hero-stats{
    display:flex;
    gap:38px;
    padding-top:30px;
    border-top:1px solid rgba(58,36,24,0.14);
  }
  .hero-stats div strong{
    font-family:'Fraunces',serif;
    font-size:28px;
    font-weight:500;
    display:block;
    color:var(--ocean-dark);
  }
  .hero-stats div span{
    font-size:12.5px;
    color:var(--cacau-soft);
    letter-spacing:0.02em;
  }

  .hero-visual{
    position:relative;
    height:560px;
  }
  .blob{
    position:absolute;
    inset:0;
    border-radius:48% 52% 60% 40% / 45% 40% 60% 55%;
    background:linear-gradient(150deg, var(--ocean-light) 0%, var(--ocean) 55%, var(--ocean-dark) 100%);
    box-shadow:0 40px 80px -20px rgba(31,75,71,0.45);
    animation:morph 14s ease-in-out infinite;
  }
  @keyframes morph{
    0%,100%{border-radius:48% 52% 60% 40% / 45% 40% 60% 55%;}
    50%{border-radius:60% 40% 45% 55% / 55% 60% 40% 45%;}
  }
  .hero-visual::before{
    content:'';
    position:absolute;
    top:8%;left:-6%;
    width:180px;height:180px;
    border-radius:50%;
    background:var(--rose);
    opacity:0.85;
    z-index:1;
  }
  .hero-visual::after{
    content:'';
    position:absolute;
    bottom:6%;right:2%;
    width:110px;height:110px;
    border-radius:50%;
    border:2px solid var(--gold);
    z-index:1;
  }
  .hero-badge{
    position:absolute;
    top:6%;right:6%;
    z-index:2;
    background:var(--gold);
    color:var(--cacau);
    font-family:'Fraunces',serif;
    font-weight:600;
    font-size:13px;
    padding:10px 16px;
    border-radius:100px;
    box-shadow:0 14px 30px rgba(201,164,103,0.5);
    display:flex;
    align-items:center;
    gap:6px;
    transform:rotate(-4deg);
  }
  .hero-card{
    position:absolute;
    bottom:32px;left:-40px;
    background:var(--white);
    padding:20px 24px;
    border-radius:16px;
    box-shadow:0 20px 50px -12px rgba(58,36,24,0.25);
    z-index:2;
    max-width:230px;
  }
  .hero-card .stars{color:var(--gold);font-size:14px;letter-spacing:2px;margin-bottom:6px;}
  .hero-card p{font-size:13px;color:var(--cacau-soft);}
  .hero-card strong{font-family:'Fraunces',serif;font-size:15px;font-weight:500;}

  /* wave divider */
  .wave{
    display:block;
    width:100%;
    line-height:0;
  }
  .wave svg{width:100%;height:auto;display:block;}

  /* ===== SECTION HEADERS ===== */
  .sec-head{
    max-width:600px;
    margin-bottom:56px;
  }
  .sec-head h2{
    font-size:clamp(30px,4vw,44px);
    margin-top:14px;
  }
  .sec-head p{
    color:var(--cacau-soft);
    font-size:16.5px;
    margin-top:16px;
    max-width:520px;
  }
  .center{text-align:center;margin-left:auto;margin-right:auto;}

  /* ===== ABOUT ===== */
  .about{
    padding:120px 0;
    background:var(--cream);
  }
  .about-grid{
    display:grid;
    grid-template-columns:0.85fr 1.15fr;
    gap:70px;
    align-items:center;
  }
  .about-media{
    position:relative;
  }
.about-media .frame{
    aspect-ratio:4/5;
    border-radius:var(--radius);
    background-image:url(data:image/jpeg;base64,);
    background-size:cover;
    background-position:center;
    position:relative;
    overflow:hidden;
    box-shadow:0 30px 60px -20px rgba(46,27,18,0.35);
  }
  .about-media .frame::before{
    content:'';
    position:absolute;inset:0;
    background:
      linear-gradient(180deg, rgba(46,27,18,0) 55%, rgba(46,27,18,0.55) 100%),
      radial-gradient(circle at 75% 15%, rgba(168,70,92,0.25), transparent 50%);
  }
  .about-media .frame-tag{
    position:absolute;
    top:-18px;right:-18px;
    background:var(--cacau);
    color:var(--cream);
    padding:16px 20px;
    border-radius:14px;
    font-family:'Fraunces',serif;
    font-size:14px;
    max-width:180px;
    box-shadow:0 16px 34px rgba(58,36,24,0.3);
    transform:rotate(3deg);
  }
  .about-text p{
    color:var(--cacau-soft);
    font-size:16.5px;
    margin-bottom:18px;
    max-width:520px;
  }
  .about-list{
    margin-top:30px;
    display:flex;
    flex-direction:column;
    gap:14px;
  }
  .about-list li{
    display:flex;
    align-items:flex-start;
    gap:12px;
    font-size:15px;
    color:var(--cacau);
  }
  .check{
    width:22px;height:22px;
    border-radius:50%;
    background:var(--ocean);
    color:var(--white);
    display:flex;align-items:center;justify-content:center;
    flex-shrink:0;
    font-size:12px;
    margin-top:1px;
  }

  /* ===== SERVICES ===== */
  .services{
    padding:120px 0;
    background:var(--white);
  }
  .service-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:26px;
  }
  .service-card{
    background:var(--cream);
    border-radius:var(--radius);
    padding:36px 30px;
    transition:transform .35s ease, box-shadow .35s ease, background .35s ease;
    position:relative;
    overflow:hidden;
  }
  .service-card:hover{
    transform:translateY(-8px);
    box-shadow:0 24px 46px -18px rgba(58,36,24,0.22);
    background:var(--white);
  }
  .service-card .icon{
    width:52px;height:52px;
    border-radius:14px;
    background:var(--ocean);
    color:var(--white);
    display:flex;align-items:center;justify-content:center;
    margin-bottom:22px;
  }
  .service-card.featured{
    background:var(--ocean-dark);
    color:var(--white);
  }
  .service-card.featured h3, .service-card.featured p{color:var(--white);}
  .service-card.featured .icon{background:var(--rose);color:var(--cacau);}
  .service-card h3{
    font-size:20px;
    margin-bottom:10px;
    font-weight:500;
  }
  .service-card p{
    color:var(--cacau-soft);
    font-size:14.5px;
  }
  .service-card .price{
    display:block;
    margin-top:18px;
    font-size:13px;
    font-weight:700;
    letter-spacing:0.03em;
    color:var(--ocean);
  }
  .service-card.featured .price{color:var(--rose);}

  /* ===== TESTIMONIALS ===== */
.atmosphere{
    position:relative;
    min-height:460px;
    display:flex;
    align-items:center;
    justify-content:center;
    text-align:center;
    background-image:url(data:image/jpeg;base64,);
    background-size:cover;
    background-position:center 25%;
    overflow:hidden;
  }
  .atmosphere::before{
    content:'';
    position:absolute;inset:0;
    background:linear-gradient(180deg, rgba(46,27,18,0.45) 0%, rgba(110,36,56,0.72) 100%);
  }
  .atmosphere-content{
    position:relative;
    z-index:1;
    padding:0 24px;
  }
  .atmosphere-content .eyebrow{color:var(--gold);}
  .atmosphere-content h2{
    color:var(--white);
    font-style:italic;
    font-size:clamp(26px,4vw,44px);
    max-width:680px;
    margin:16px auto 0;
    line-height:1.25;
  }

  .testimonials{
    padding:110px 0;
    background:var(--cacau);
    color:var(--cream);
    position:relative;
  }
  .testimonials .eyebrow{color:var(--rose);}
  .testimonials h2{color:var(--cream);}
  .t-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:24px;
    margin-top:20px;
  }
  .t-card{
    background:rgba(255,253,249,0.06);
    border:1px solid rgba(255,253,249,0.12);
    border-radius:var(--radius);
    padding:30px 28px;
  }
  .t-card .stars{color:var(--gold);letter-spacing:2px;margin-bottom:16px;font-size:14px;}
  .t-card p{font-size:15px;color:rgba(247,239,229,0.85);margin-bottom:20px;}
  .t-card .who{display:flex;align-items:center;gap:12px;}
  .t-avatar{
    width:38px;height:38px;border-radius:50%;
    background:var(--rose);
    display:flex;align-items:center;justify-content:center;
    font-family:'Fraunces',serif;color:var(--cacau);font-size:14px;
  }
  .t-card .who strong{display:block;font-size:14px;font-weight:700;}
  .t-card .who span{font-size:12.5px;color:rgba(247,239,229,0.55);}

  /* ===== CONTACT ===== */
  .contact{
    padding:120px 0;
    background:var(--cream);
  }
  .contact-grid{
    display:grid;
    grid-template-columns:1fr 0.85fr;
    gap:0;
    border-radius:28px;
    overflow:hidden;
    box-shadow:0 30px 70px -30px rgba(58,36,24,0.28);
  }
  .contact-form{
    background:var(--white);
    padding:56px;
  }
  .contact-form h3{font-size:26px;margin-bottom:8px;}
  .contact-form>p{color:var(--cacau-soft);font-size:14.5px;margin-bottom:32px;}
  .field{margin-bottom:20px;}
  .field label{
    display:block;
    font-size:12.5px;
    font-weight:700;
    letter-spacing:0.04em;
    text-transform:uppercase;
    color:var(--cacau-soft);
    margin-bottom:8px;
  }
  .field input, .field select, .field textarea{
    width:100%;
    padding:14px 16px;
    border-radius:12px;
    border:1.5px solid var(--cream-2);
    background:var(--cream);
    font-family:'Manrope',sans-serif;
    font-size:14.5px;
    color:var(--cacau);
    transition:border-color .25s ease, background .25s ease;
  }
  .field input:focus, .field select:focus, .field textarea:focus{
    border-color:var(--ocean);
    background:var(--white);
  }
  .field textarea{resize:vertical;min-height:100px;}
  .field-row{display:grid;grid-template-columns:1fr 1fr;gap:16px;}
  .form-note{
    font-size:12.5px;
    color:var(--cacau-soft);
    margin-top:14px;
    display:flex;
    gap:8px;
    align-items:flex-start;
  }

  .contact-info{
    background:var(--ocean-dark);
    color:var(--cream);
    padding:56px 48px;
    display:flex;
    flex-direction:column;
    justify-content:space-between;
    position:relative;
    overflow:hidden;
  }
  .contact-info::before{
    content:'';
    position:absolute;
    width:260px;height:260px;
    border-radius:50%;
    background:rgba(255,255,255,0.05);
    top:-80px;right:-80px;
  }
  .contact-info h3{color:var(--cream);font-size:24px;margin-bottom:26px;}
  .info-item{
    display:flex;
    gap:16px;
    margin-bottom:24px;
    position:relative;
    z-index:1;
  }
  .info-item .ic{
    width:42px;height:42px;
    border-radius:12px;
    background:rgba(255,255,255,0.1);
    display:flex;align-items:center;justify-content:center;
    flex-shrink:0;
  }
  .info-item strong{display:block;font-size:14.5px;margin-bottom:3px;}
  .info-item span, .info-item a{font-size:13.5px;color:rgba(247,239,229,0.75);}
  .info-item a:hover{color:var(--rose);}
  .social-row{
    display:flex;gap:12px;
    margin-top:20px;
    position:relative;z-index:1;
  }
  .social-row a{
    width:40px;height:40px;
    border-radius:50%;
    border:1.5px solid rgba(255,255,255,0.25);
    display:flex;align-items:center;justify-content:center;
    transition:background .25s ease, transform .25s ease;
  }
  .social-row a:hover{background:var(--rose);transform:translateY(-3px);}

  /* ===== FOOTER ===== */
  footer{
    background:var(--cacau);
    color:rgba(247,239,229,0.6);
    padding:40px 0;
  }
  .foot-row{
    display:flex;
    justify-content:space-between;
    align-items:center;
    flex-wrap:wrap;
    gap:16px;
    font-size:13px;
  }
  .foot-row .logo{color:var(--cream);font-size:18px;}
  .foot-row .logo em{color:var(--rose);}

  /* ===== WHATSAPP FLOAT ===== */
  .wa-float{
    position:fixed;
    bottom:26px;right:26px;
    z-index:200;
    width:62px;height:62px;
    border-radius:50%;
    background:#25D366;
    display:flex;align-items:center;justify-content:center;
    box-shadow:0 12px 30px rgba(37,211,102,0.45);
    transition:transform .3s ease;
    animation:pulse 2.6s ease-in-out infinite;
  }
  .wa-float:hover{transform:scale(1.08);}
  @keyframes pulse{
    0%,100%{box-shadow:0 12px 30px rgba(37,211,102,0.45);}
    50%{box-shadow:0 12px 30px rgba(37,211,102,0.75), 0 0 0 10px rgba(37,211,102,0.12);}
  }

  /* ===== REVEAL ANIMATION ===== */
  .reveal{
    opacity:0;
    transform:translateY(24px);
    transition:opacity .8s ease, transform .8s ease;
  }
  .reveal.in{opacity:1;transform:none;}

  @media (prefers-reduced-motion: reduce){
    .blob{animation:none;}
    .wa-float{animation:none;}
    .reveal{transition:none;opacity:1;transform:none;}
  }

  /* ===== RESPONSIVE ===== */
  @media (max-width:1024px){
    .hero-grid{grid-template-columns:1fr;}
    .hero-visual{height:420px;order:-1;}
    .hero-card{left:16px;}
    .about-grid{grid-template-columns:1fr;}
    .about-media{max-width:420px;margin:0 auto;}
    .service-grid{grid-template-columns:repeat(2,1fr);}
    .t-grid{grid-template-columns:1fr;}
    .contact-grid{grid-template-columns:1fr;}
  }

  @media (max-width:760px){
    .wrap{padding:0 22px;}
    .nav-links{
      position:fixed;
      top:0;right:0;
      height:100vh;
      width:78%;
      max-width:320px;
      background:var(--cream);
      flex-direction:column;
      justify-content:center;
      align-items:flex-start;
      gap:28px;
      padding:40px;
      transform:translateX(100%);
      transition:transform .4s ease;
      box-shadow:-10px 0 40px rgba(0,0,0,0.12);
      font-size:18px;
    }
    .nav-links.open{transform:translateX(0);}
    .menu-toggle{
      display:flex;
      flex-direction:column;
      gap:5px;
      width:30px;
      z-index:110;
    }
    .menu-toggle span{width:100%;height:2px;background:var(--cacau);border-radius:2px;transition:.3s;}
    .nav-cta .btn-ghost{display:none;}
    .hero{padding:120px 0 80px;}
    .hero-stats{flex-wrap:wrap;gap:24px;}
    .service-grid{grid-template-columns:1fr;}
    .contact-form{padding:34px 26px;}
    .contact-info{padding:40px 26px;}
    .field-row{grid-template-columns:1fr;}
    .about-media .frame-tag{max-width:150px;font-size:12.5px;padding:12px 14px;}
    .foot-row{flex-direction:column;text-align:center;}
  }
</style>
</head>
<body>

<header id="header">
  <div class="wrap">
    <nav>
      <a href="#top" class="logo">Corpo<em>e</em>forma</a>
      <ul class="nav-links" id="navLinks">
        <li><a href="#sobre">Estúdio</a></li>
        <li><a href="#servicos">Serviços</a></li>
        <li><a href="#depoimentos">Depoimentos</a></li>
        <li><a href="#contato">Contato</a></li>
